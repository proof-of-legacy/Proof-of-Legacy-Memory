# Blacklist de IPs abusivos
geo $blocked_ip {
    default 0;
    103.144.90.50 1;
    36.162.167.42 1;
    125.164.208.167 1;
}

server {
    listen 80;
    server_name polm.com.br;
    return 301 https://polm.com.br$request_uri;
}

server {
    listen 443 ssl;
    server_name polm.com.br;
    ssl_certificate /etc/letsencrypt/live/polm.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/polm.com.br/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    root /var/www/html;
    index index.html;

    location /api/ {
        if ($blocked_ip) {
            return 403 "Blocked";
        }
        proxy_pass http://localhost:6060/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type" always;
    }

    location /roadmap {
        try_files $uri $uri.html =404;
        add_header Content-Security-Policy "default-src * blob: data: 'unsafe-inline' 'unsafe-eval'" always;
    }
    location /claim {
        try_files $uri $uri.html =404;
    }
    location / {
        try_files $uri $uri/ =404;
        add_header Content-Security-Policy "default-src * blob: data: 'unsafe-inline' 'unsafe-eval'" always;
    }
}

server {
    listen 80;
    server_name explorer.polm.com.br;
    return 301 https://explorer.polm.com.br$request_uri;
}

server {
    listen 443 ssl;
    server_name explorer.polm.com.br;
    ssl_certificate /etc/letsencrypt/live/polm.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/polm.com.br/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        proxy_pass http://localhost:5050;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
